<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.WebGrab" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#10131A</item>
        <item name="android:colorBackground">#10131A</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- Android 15（targetSdk 35）强制 edge-to-edge，这里显式声明裁切区行为 -->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
